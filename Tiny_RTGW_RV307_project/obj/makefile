# Add inputs and outputs from these tool invocations to the build variables 
SECONDARY_FLASH += \
Tiny_RTGW_RV307.hex \

SECONDARY_LIST += \
Tiny_RTGW_RV307.lst \

SECONDARY_SIZE += \
Tiny_RTGW_RV307.siz \


# All Target
all: 
	$(MAKE) --no-print-directory main-build 

main-build: Tiny_RTGW_RV307.elf secondary-outputs

# Tool invocations
Tiny_RTGW_RV307.elf: $(OBJS) $(USER_OBJS_ESCAPE)
	@	riscv-none-embed-gcc -march=rv32imacxw -mabi=ilp32 -msmall-data-limit=8 -msave-restore -fmax-errors=20 -Os -fmessage-length=0 -fsigned-char -ffunction-sections -fdata-sections -fno-common -Wunused -Wuninitialized -g -T "d:\WCH_qinheng\project\Tiny_RTGW_RV307\Ld\Link.ld" -nostartfiles -Xlinker --gc-sections -Xlinker --print-memory-usage -Wl,-Map,"Tiny_RTGW_RV307.map" --specs=nano.specs --specs=nosys.specs -o "Tiny_RTGW_RV307.elf" @objWrapFile.rsp $(LIBS)
Tiny_RTGW_RV307.hex: Tiny_RTGW_RV307.elf
	@	riscv-none-embed-objcopy -O ihex "Tiny_RTGW_RV307.elf" "Tiny_RTGW_RV307.hex"
Tiny_RTGW_RV307.lst: Tiny_RTGW_RV307.elf
	@	riscv-none-embed-objdump --all-headers --demangle --disassemble -M xw "Tiny_RTGW_RV307.elf" > "Tiny_RTGW_RV307.lst"
Tiny_RTGW_RV307.siz: Tiny_RTGW_RV307.elf
	riscv-none-embed-size --format=berkeley "Tiny_RTGW_RV307.elf"

# Other Targets
clean:
	-$(RM) $(DIR_OBJS) $(SECONDARY_FLASH)$(SECONDARY_LIST)$(SECONDARY_SIZE)objWrapFile.rsp Tiny_RTGW_RV307.elf
	-$(RM) $(DIR_EXPANDS) $(CALLGRAPH_DOT)
	-$(RM) $(DIR_DEPS)
secondary-outputs: $(SECONDARY_FLASH) $(SECONDARY_LIST) $(SECONDARY_SIZE)

.PHONY: all clean dependents

